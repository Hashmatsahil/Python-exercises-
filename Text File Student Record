def save_student(file_name: str, student_id: int, student_name: str) -> None:
    with open("records.txt", "a", encoding="utf-8") as file:
        file.write(f"{student_id} | {student_name}\n")


def show_students(file_name: str) -> None:
    with open("records.txt", "r", encoding="utf-8") as file:
        for record in file:
            print(record.rstrip())


